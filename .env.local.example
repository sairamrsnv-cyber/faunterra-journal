# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#   cp .env.local.example .env.local && chmod 600 .env.local
#
# The scheduled job does NOT inherit your shell, so the token must live here
# rather than only being exported in a terminal.

# Free key: https://ebird.org/api/keygen
EBIRD_API_TOKEN=

# Comma-separated eBird region codes. https://ebird.org/region/world
EBIRD_REGIONS=IN

# Where the local archive lives. Defaults to ./ebird-archive.
# Point it at external storage if you prefer; the scripts verify the volume is
# actually mounted before writing, and refuse if it is not.
# EBIRD_ARCHIVE_DIR=/Volumes/LaCie/faunterra/ebird-archive
